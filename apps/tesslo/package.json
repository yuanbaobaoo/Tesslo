{
  "name": "@tesslo/app",
  "productName": "Tesslo",
  "description": "Tesslo - an unofficial, Scratch-compatible block editor for HarmonyOS 7",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "clean": "rimraf ./desktop/dist",
    "compile:renderer": "webpack --config desktop/webpack.renderer.js",
    "compile:main": "webpack --config desktop/webpack.main.js",
    "compile": "pnpm run compile:renderer && pnpm run compile:main"
  },
  "dependencies": {
    "prop-types": "15.8.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.0",
    "@babel/plugin-proposal-object-rest-spread": "7.20.7",
    "@babel/plugin-syntax-dynamic-import": "7.8.3",
    "@babel/plugin-transform-async-to-generator": "7.28.6",
    "@babel/plugin-transform-nullish-coalescing-operator": "7.28.6",
    "@babel/plugin-transform-optional-chaining": "7.28.6",
    "@babel/preset-env": "7.29.5",
    "@babel/preset-react": "7.28.5",
    "@scratch/scratch-gui": "workspace:*",
    "autoprefixer": "10.5.0",
    "babel-loader": "9.2.1",
    "copy-webpack-plugin": "6.4.1",
    "css-loader": "5.2.7",
    "fs-extra": "9.1.0",
    "html-loader": "0.5.5",
    "html-webpack-plugin": "5.6.7",
    "lodash.bindall": "4.4.0",
    "lodash.omit": "4.18.0",
    "minilog": "3.1.0",
    "minimist": "1.2.8",
    "postcss-import": "12.0.1",
    "postcss-loader": "4.3.0",
    "postcss-simple-vars": "5.0.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-redux": "8.1.3",
    "redux": "4.2.1",
    "rimraf": "3.0.2",
    "style-loader": "4.0.0",
    "url-loader": "4.1.1",
    "webpack": "5.106.2",
    "webpack-cli": "5.1.4",
    "webpack-merge": "4.2.2"
  }
}
