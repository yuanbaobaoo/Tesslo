{
  app: {
    products: [
      {
        name: 'default',
        compatibleSdkVersion: '26.0.0',
        compatibleSdkVersionStage: 'release',
        runtimeOS: 'HarmonyOS',
        buildOption: {
          nativeLib: {
            collectAllLibs: true,
          },
        },
      },
    ],
    buildModeSet: [
      { name: 'debug' },
      { name: 'release' },
    ],
  },
  modules: [
    {
      name: 'entry',
      srcPath: './entry',
      targets: [
        {
          name: 'default',
          applyToProducts: ['default'],
        },
      ],
    },
  ],
}
