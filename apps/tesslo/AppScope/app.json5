{
  "app": {
    "bundleName": "io.github.yuanbaobaoo.tesslo",
    "vendor": "Tesslo",
    "versionCode": 1000002,
    "versionName": "0.1.1",
    "icon": "$media:tesslo_app_icon",
    "label": "$string:app_name",
    "configuration": "$profile:configuration",
    "multiAppMode": {
      "multiAppModeType": "multiInstance",
      "maxCount": 1
    }
  }
}
