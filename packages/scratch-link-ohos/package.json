    "build": "esbuild src/index.js --bundle --platform=node --format=cjs --external:electron --outfile=dist/scratch-link.cjs"
  },
  "dependencies": {
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
