{
  "name": "@tesslo/scratch-link-ohos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Scratch Link protocol server for Tesslo (HarmonyOS transport bridge)",
  "license": "AGPL-3.0-only",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "bin": {
