# Tesslo 构建脚本的环境配置示例。
# 复制为 .env 后按需修改；已导出的环境变量优先于 .env。
# 所有路径均为绝对路径。

# DevEco command-line-tools 根目录（含 bin/hvigorw 与 sdk/）。
# 不设置时按顺序探测：~/command-line-tools、/Users/Shared/local/ohos/command-line-tools*、PATH 上的 hvigorw
#OHOS_COMMAND_LINE_TOOLS_ROOT=/path/to/command-line-tools

# OHOS Native SDK 根目录（含 native/oh-uni-package.json），供 build:link:csharp 交叉编译 C# 桥。
# 不设置时按顺序探测：/Users/Shared/local/ohos/command-line-tools_*/sdk/default、~/Library/Huawei/Sdk、/Applications/DevEco-Studio.app/Contents/sdk/default
#OHOS_SDK_ROOT=/path/to/sdk/default

# .NET 安装根目录（含 dotnet 可执行文件），供 build:link:csharp 使用。
# 不设置时默认 ~/.dotnet
#DOTNET_ROOT=/path/to/.dotnet

# hvigor 构建使用的 JDK。
# 不设置时按顺序探测：JAVA_HOME、~/.sdkman/candidates/java/21.0.11-tem、~/.sdkman/candidates/java/current
#JAVA_HOME=/path/to/jdk-21
