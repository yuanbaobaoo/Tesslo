{
  // scripts/ 的类型检查配置：Node 原生类型擦除（>=22.18）直接运行 .ts，
  // tsc 只做 noEmit 检查，不产出 JS；erasableSyntaxOnly 与 Node 的擦除能力对齐
  // （禁止 enum/namespace 等不可擦除语法），allowImportingTsExtensions 允许
  // 相对导入写 .ts 后缀（运行时按字面路径加载）。
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2023"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": ["*.ts"]
}
