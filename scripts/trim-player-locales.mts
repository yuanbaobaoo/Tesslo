// player 语言包裁剪：scratch-l10n 的 editor-msgs 含 74 个语言（~4.6MB），
// 导出的执行文件只需要 zh-cn + en（P1 方案：player 仅双语）。
// 从引擎的 editor-msgs.js 提取目标语言块，生成裁剪模块供 webpack.player 别名引用。
// 运行：node scripts/trim-player-locales.mts（build:player 链自动调用）
import fs from 'node:fs';
import path from 'node:path';
import {fileURLToPath} from 'node:url';

// 保留语言（与播放端 EditorState locale 一致）
const KEEP_LOCALES: ReadonlyArray<string> = ['zh-cn', 'en'];

const repoRoot: string = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
const sourcePath: string = path.join(
    repoRoot, 'packages/engine/scratch/scratch-l10n/locales/editor-msgs.js');
const outDir: string = path.join(
    repoRoot, 'packages/engine/scratch/scratch-gui/.l10n-trimmed');
const outPath: string = path.join(outDir, 'editor-msgs-trimmed.js');

const source: string = fs.readFileSync(sourcePath, 'utf8');

/**
 * 按语言键提取 `"xx": { ... }` 块（源文件是 GENERATED 格式，缩进固定 2 空格）。
 *
 * @param locale - 语言键（如 zh-cn）。
 * @returns 该语言的块文本；找不到时 null。
 */
const extractBlock = (locale: string): string | null => {
    const header = `  "${locale}": {`;
    const start: number = source.indexOf(header);
    if (start < 0) {
        return null;
    }
    const end: number = source.indexOf('\n  },', start);
    if (end < 0) {
        return null;
    }
    return source.substring(start, end + 5); // 含 "  },"
};

const blocks: string[] = [];
for (const locale of KEEP_LOCALES) {
    const block: string | null = extractBlock(locale);
    if (block === null) {
        throw new Error(`[trim-player-locales] locale block not found: ${locale}`);
    }
    blocks.push(block);
}

const trimmed: string = `// GENERATED by scripts/trim-player-locales.mts —— 播放端双语裁剪（${KEEP_LOCALES.join(', ')}）
export default {
${blocks.join('\n')}
};
`;

fs.mkdirSync(outDir, {recursive: true});
fs.writeFileSync(outPath, trimmed);
const savedKb: number = (source.length - trimmed.length) / 1024;
console.log(
    `[trim-player-locales] ${KEEP_LOCALES.join('+')} → ${(trimmed.length / 1024).toFixed(0)}KB ` +
    `(原 ${(source.length / 1024 / 1024).toFixed(1)}MB，省 ${(savedKb / 1024).toFixed(1)}MB 源码)`
);
